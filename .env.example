# Copy to .env.local for `vercel dev`, or set in Vercel Project → Settings → Environment Variables.

# Required for AI coach / hint endpoints
OPENAI_API_KEY=sk-...

# Optional model override (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Set to "false" to force rule-based coach even when a key is present
AI_COACH_ENABLED=true
